pragma language_version >= 0.23;

import CompactStandardLibrary;

// Public result of the most recent Kaira Private Guard verification.
//
// Sensitive financial inputs are NOT stored on the public ledger.
export ledger lastVerification: Boolean;

/**
 * Kaira Private Guard
 *
 * Proves whether a proposed purchase satisfies the user's
 * private financial safety requirements.
 *
 * Private inputs:
 * - currentBalance
 * - upcomingCommitments
 * - reservedSavings
 * - safetyBuffer
 * - purchaseAmount
 *
 * Only the final Boolean eligibility result is disclosed.
 */
export circuit verifyPurchase(
    currentBalance: Uint<64>,
    upcomingCommitments: Uint<64>,
    reservedSavings: Uint<64>,
    safetyBuffer: Uint<64>,
    purchaseAmount: Uint<64>
): [] {
    const requiredFunds =
        upcomingCommitments
        + reservedSavings
        + safetyBuffer
        + purchaseAmount;

    const eligible = currentBalance >= requiredFunds;

    lastVerification = disclose(eligible);
}